# Firebase web app config (Firebase console → Project settings → Your apps → SDK setup).
# These values are public identifiers, not secrets. Copy this file to .env.local and fill them in.
# Firestore is not used; goals and dreams stay in the browser under the signed-in account.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
